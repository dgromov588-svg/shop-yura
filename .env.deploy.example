# Налаштування заливки. Скопіюйте у .env.deploy (НЕ потрапляє в git) лише якщо
# треба щось змінити — значення за замовчуванням уже вбудовані в deploy.mjs.
#
# Паролі не обовʼязкові: deploy.mjs запитає їх приховано і запропонує запамʼятати.
# Забути збережені паролі:  node deploy.mjs --forget

# ---------- FTP (CityHost) ----------
DEPLOY_HOST=amarok.cityhost.com.ua
DEPLOY_USER=ch9ca38181
DEPLOY_FTP_PORT=21
DEPLOY_FTP_PATH=www/antikvardp.net
DEPLOY_FTP_PASSWORD=

# ---------- Сайт ----------
DEPLOY_URL=https://antikvardp.net

# ---------- MySQL для адмінки ----------
# Пароль потрібен один раз: скрипт збереже доступ на сервері (~/antikvar-data/db.php)
DEPLOY_DB_HOST=127.0.0.1
DEPLOY_DB_NAME=ch9ca38181
DEPLOY_DB_USER=ch9ca38181
DEPLOY_DB_PASSWORD=

# Секрет для заливки з телефону через GitHub (мін. 16 символів, необовʼязково)
DEPLOY_HOOK_SECRET=
